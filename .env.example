# PostgreSQL
POSTGRES_DB=coastwatch
POSTGRES_USER=coastwatch
POSTGRES_PASSWORD=coastwatch_secret

# Backend
DATABASE_URL=postgresql+asyncpg://coastwatch:coastwatch_secret@db:5432/coastwatch
SECRET_KEY=change_this_in_production

# Google Earth Engine
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=/path/to/gee-key.json

# SAP AI Core (chatbot)
LLM_API_CONFIG={"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}
AICORE_RESOURCE_GROUP=default
AICORE_LLM_MODEL=gpt-4o

# Frontend
VITE_API_URL=http://localhost:8000
