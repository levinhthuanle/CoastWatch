# CoastWatch Backend Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://coastwatch:password@localhost:5432/coastwatch_db

# Security
SECRET_KEY=your-secret-key-change-in-production

# Google Earth Engine
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=/app/credentials/gee-key.json

# SAP AI Core
LLM_API_CONFIG={"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}
AICORE_RESOURCE_GROUP=default
AICORE_LLM_MODEL=gpt-4o
